# ==============================================================================
# CommuteCircle - Environment Configuration Template
# Copy this file to .env before starting the application
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rideshare_db?schema=public"

# Authentication & Security
JWT_SECRET=super_secret_jwt_passphrase_for_development_minimum_32_chars!
JWT_EXPIRES_IN=7d

# Institution Domain Whitelist (Comma-separated)
# Signups and logins are strictly restricted to these domain suffixes
ALLOWED_EMAIL_DOMAINS="college.edu,campus.edu,university.edu,org.com"

# Google OAuth 2.0 Credentials (Optional for local dev with dev-login bypass)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Client App Configuration (Vite)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
