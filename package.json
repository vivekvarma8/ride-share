{
  "name": "commute-circle-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Campus and community ride-sharing web application",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=server",
    "test:watch": "npm run test:watch --workspace=server",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:generate": "npm run db:generate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "clean": "npm run clean --workspaces --if-present",
    "start": "npm run start --workspace=server",
    "start:prod": "npx prisma db push --schema=apps/server/prisma/schema.prisma && npm run start --workspace=server",
    "db:push": "npm run db:push --workspace=server",
    "render-build": "npm install --include=dev && npm run db:generate && npm run build"
  },
  "keywords": [
    "rideshare",
    "carpooling",
    "campus",
    "typescript",
    "react",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "",
  "license": "ISC"
}
